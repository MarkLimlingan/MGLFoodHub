# Hidden admin login route. Change this to something only your team knows.
VITE_ADMIN_PATH=/mgl-hub-admin-portal

# Optional for `npm run dev`: proxy /api and /uploads to live Hostinger instead of local `npm run dev:api`.
# VITE_API_TARGET=https://mglfoodhub.com

# Only for npm run export:supabase (copying the menu and settings out of the old Supabase project).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
